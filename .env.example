# ==============================================================================
# ANGKOR QUANT - INSTITUTIONAL CONFIGURATION BLUEPRINT (.env.example)
# ==============================================================================

# 1. Telegram Bot Token សម្រាប់បញ្ជា Bot
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Gemini API Key សម្រាប់ខួរក្បាល AI
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Master Key សម្រាប់ចាក់សោសុវត្ថិភាព API របស់សមាជិក (Fernet Key)
MASTER_KEY="your_fernet_master_key_here"

# 4. Paper Trading Toggle (False = Live Trading, True = Simulation)
PAPER_TRADING=False

# 5. Hugging Face AI Super Brain Microservice Config
HF_SPACE_URL="https://your-space.hf.space"
HF_TOKEN="your_hf_token_here"

# 6. Aave V3 Flash Loan Smart Contract (Arbitrum One Mainnet)
FLASH_LOAN_CONTRACT_ADDRESS="0x05A2A4fFa5276b96BD5977DDd033Ab1a3E527382"

# 7. Dedicated Owner & Keeper Relayer Private Key (Arbitrum One)
KEEPER_RELAYER_PRIVATE_KEY="your_keeper_relayer_private_key"

# 8. Web3 Settlement & Token Configuration (Arbitrum One)
USDT_CONTRACT_ADDRESS="0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9"
RECIPIENT_WALLET_ADDRESS="your_recipient_wallet_address"
KEEPER_RELAYER_ADDRESS="your_keeper_relayer_address"

SOLANA_BOT_PRIVATE_KEY="your_solana_bot_private_key"
SOLANA_BOT_PUBLIC_KEY="your_solana_bot_public_key"

# 9. Telegram Mini App & Web GUI HTTPS URL (Cloudflare Tunnel / HF Space)
TELEGRAM_MINI_APP_URL="https://your-domain.trycloudflare.com"

# TradFi Capital.com Broker API Credentials
CAPITAL_API_KEY="your_capital_api_key"
CAPITAL_IDENTIFIER="your_capital_identifier_email"
CAPITAL_PASSWORD="your_capital_password"
CAPITAL_IS_DEMO=false
CAPITAL_ACCOUNT_ID="your_capital_live_account_id"

