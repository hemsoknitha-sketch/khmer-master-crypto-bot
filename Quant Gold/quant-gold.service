# ==============================================================================
# ANGKOR QUANT - QUANT GOLD SYSTEMD SERVICE CONFIGURATION (AQ84 HARDENED)
# ==============================================================================
# Location on Linux VPS: /etc/systemd/system/quant-gold.service
# Target: Google Cloud Linux VPS (quant-gold / quant-gold-514007)
# ==============================================================================

[Unit]
Description=Angkor Quant - Quant Gold 24/7/365 Autonomous AI Trading Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sokni
Group=sokni
WorkingDirectory=/opt/khmer-master-crypto-bot
ExecStart=/opt/khmer-master-crypto-bot/venv/bin/python run_quant_gold.py
Restart=always
RestartSec=5
SuccessExitStatus=0
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quant-gold

# Resource protection & zero-leakage limits (Zero OOM Shield)
LimitNOFILE=65535
MemoryMax=850M
MemoryHigh=750M
TimeoutStopSec=15
KillMode=mixed

# Institutional Linux Security Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
