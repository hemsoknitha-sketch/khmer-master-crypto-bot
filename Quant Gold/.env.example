# ==============================================================================
# ANGKOR QUANT - QUANT GOLD INSTITUTIONAL CONFIGURATION (.env.example)
# ==============================================================================
# Target Environment: Google Cloud Linux VPS (quant-gold)
# Project ID: quant-gold-514007 | Zone: us-central1-a | Instance: quant-gold
# Console: https://console.cloud.google.com/compute/instancesDetail/zones/us-central1-a/instances/quant-gold?project=quant-gold-514007
# ==============================================================================

# 1. Google Cloud VPS Linux Deployment Configuration
GCP_PROJECT_ID="quant-gold-514007"
GCP_ZONE="us-central1-a"
GCP_INSTANCE_NAME="quant-gold"
GCP_CONSOLE_URL="https://console.cloud.google.com/compute/instancesDetail/zones/us-central1-a/instances/quant-gold?project=quant-gold-514007"
VPS_HOST="your_vps_external_ip_here"
VPS_USER="sokni"
VPS_DEPLOY_PATH="/opt/khmer-master-crypto-bot"
VPS_SERVICE_NAME="quant-gold.service"

# 2. Cloud AI Super Models (Free 24/7/365 Serverless Quorum)
# DeepSeek-R1 & Meta-Llama-3.3-70B via Hugging Face Access Token
HF_TOKEN="your_hugging_face_access_token_here"

# Google Gemini 2.5 Flash via Google AI Studio API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Capital.com TradFi Broker API Credentials (Gold / XAUUSD)
CAPITAL_API_KEY="your_capital_api_key"
CAPITAL_IDENTIFIER="your_capital_identifier_email"
CAPITAL_PASSWORD="your_capital_password"
CAPITAL_IS_DEMO=false
CAPITAL_ACCOUNT_ID="your_capital_account_id"

# 4. Quant Gold Trading Parameters & Fiduciary Protection (AQ84)
QUANT_GOLD_ENABLED=true
QUANT_GOLD_MAX_POSITIONS=3
QUANT_GOLD_MAX_DOLLAR_RISK=2.50
QUANT_GOLD_MIN_CONFLUENCE_SCORE=80.0
QUANT_GOLD_CHOP_FILTER_ENABLED=true
QUANT_GOLD_BREAKEVEN_ARMOR=true
QUANT_GOLD_CYCLE_INTERVAL=6.0
QUANT_GOLD_TIME_ZONE="Asia/Phnom_Penh"

# 5. Telegram Bot & Instant Notification Alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
ADMIN_CHAT_ID="859271875"
CAPITAL_REFERRAL_URL=https://capital.com/referafriend-pro?c=az48cxia&pid=referral&src=inviteFriends&license=BAH&mn=ifbahpro1000
SUPPORT_TELEGRAM_HANDLE=AngkorQuantSupport

