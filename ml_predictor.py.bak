import requests
import pandas as pd
import numpy as np
import time
import os
import joblib
import warnings

warnings.filterwarnings('ignore')

def calculate_rsi(data, window=14):
    delta = data.diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=window).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=window).mean()
    rs = gain / loss
    return 100 - (100 / (1 + rs))

def calculate_atr(df, window=14):
    high_low = df['high'] - df['low']
    high_close = np.abs(df['high'] - df['close'].shift())
    low_close = np.abs(df['low'] - df['close'].shift())
    ranges = pd.concat([high_low, high_close, low_close], axis=1)
    true_range = np.max(ranges, axis=1)
    return true_range.rolling(window=window).mean()

def predict_price(symbol: str = "BTCUSDT"):
    """
    Loads a pre-trained XGBoost Regressor from Colab,
    fetches recent data to build features, and returns a 24-hour prediction.
    """
    symbol = symbol.upper().strip()
    if not symbol.endswith("USDT"):
        symbol += "USDT"
        
    model_path = f"xgboost_model_{symbol}.pkl"
    
    if not os.path.exists(model_path):
        return (
            f"❌ **[ML Engine] មិនមាន File Model សម្រាប់ {symbol} ទេ!**\n"
            f"សូមយកកូដ `train_model_colab.py` ទៅ Train នៅលើ Google Colab យក File `{model_path}` "
            f"មកដាក់ក្នុង Folder បច្ចុប្បន្នសិន ទើបអាចប្រើ AI នេះបាន។ (សន្សំ RAM & CPU សម្រាប់ VPS របស់អ្នក)"
        )

    # Load pre-trained model
    try:
        model = joblib.load(model_path)
    except Exception as e:
        return f"❌ [ML Engine] Error loading model file {model_path}: {e}"

    limit = 100 # Only need enough data to calculate SMA_30 and others
    end_time = int(time.time() * 1000)
    
    try:
        url = f"https://data-api.binance.vision/api/v3/klines?symbol={symbol}&interval=1d&limit={limit}&endTime={end_time}"
        res = requests.get(url, timeout=10)
        if res.status_code != 200:
            return f"❌ [ML Engine] API HTTP Error {res.status_code}"
            
        data = res.json()
        if not data:
            return f"❌ [ML Engine] Failed to fetch data for {symbol}."
            
        columns = ['timestamp', 'open', 'high', 'low', 'close', 'volume', 'close_time', 'quote_asset_volume', 'number_of_trades', 'taker_buy_base', 'taker_buy_quote', 'ignore']
        df = pd.DataFrame(data, columns=columns)
        
        df.drop_duplicates(subset='timestamp', inplace=True)
        df.sort_values('timestamp', inplace=True)
        
        numeric_cols = ['open', 'high', 'low', 'close', 'volume']
        df[numeric_cols] = df[numeric_cols].apply(pd.to_numeric)
        
        # Calculate features (must match the ones trained in Colab)
        df['SMA_7'] = df['close'].rolling(7).mean()
        df['SMA_30'] = df['close'].rolling(30).mean()
        df['Volatility'] = df['close'].rolling(30).std()
        df['RSI_14'] = calculate_rsi(df['close'], 14)
        df['ATR_14'] = calculate_atr(df, 14)
        df['Volume_Trend'] = df['volume'].rolling(7).mean()
        
        # We need the last row to make prediction
        latest = df.iloc[-1]
        
        # Check if we have NaN
        if pd.isna(latest['SMA_30']) or pd.isna(latest['ATR_14']):
            return f"❌ [ML Engine] Data insufficient to calculate indicators."
            
        latest_features = pd.DataFrame({
            'close': [latest['close']],
            'SMA_7': [latest['SMA_7']],
            'SMA_30': [latest['SMA_30']],
            'Volatility': [latest['Volatility']],
            'RSI_14': [latest['RSI_14']],
            'ATR_14': [latest['ATR_14']],
            'Volume_Trend': [latest['Volume_Trend']]
        })
        
        pred = model.predict(latest_features)[0]
        current_close = latest['close']
        
        diff_val = pred - current_close
        diff_pct = (diff_val / current_close) * 100
        
        # Pseudo-probability
        confidence = 75.0
        if abs(diff_pct) > 1.0:
            confidence += 10.0
        if abs(diff_pct) > 3.0:
            confidence += 10.0
            
        confidence = min(confidence, 99.0)
        
        direction = "ឡើង (UP) 🚀" if diff_pct > 0 else "ចុះ (DOWN) 📉"
        
        summary = (
            f"\n🧠 **Super Smart AI (XGBoost Pre-Trained):**\n"
            f"⚡ **Load Mode:** Fast Inference (Memory Saved)\n"
            f"📊 Indicators Active: SMA, RSI, Volatility, ATR, Volume Trend\n\n"
            f"🎯 **លទ្ធផលទស្សន៍ទាយសម្រាប់ ២៤ ម៉ោងបន្ទាប់ ({symbol}):**\n"
            f"👉 មានឱកាស **{confidence:.1f}%** ដែលតម្លៃនឹង **{direction}** ទៅដល់ **${pred:,.2f}** (បម្រែបម្រួល {diff_pct:+.2f}%)។"
        )
        
        return summary
        
    except Exception as e:
        return f"❌ [ML Engine Error]: {str(e)}"
