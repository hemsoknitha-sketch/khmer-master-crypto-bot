[Unit]
Description=Angkor Quant - Auto YouTube Live Stream 24/7 (Gold M1 HFT Signal)
After=network.target sound.target

[Service]
Type=simple
User=hemsoknitha
WorkingDirectory=/opt/khmer-master-crypto-bot
EnvironmentFile=-/opt/khmer-master-crypto-bot/.env
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8
ExecStart=/bin/bash /opt/khmer-master-crypto-bot/start_youtube_stream.sh
ExecStop=/bin/bash /opt/khmer-master-crypto-bot/stop_youtube_stream.sh
Restart=always
RestartSec=10

# CPU Affinity: Strictly Pin to Core 2 and 3 (Leaves Core 0 & 1 for HFT Bot)
CPUAffinity=2 3

# Scheduling Priority: Low priority (Nice=10) so Trading Bot always takes precedence
Nice=10

# OOM Protection: Sacrifice Streamer first before touching Trading Bot
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
