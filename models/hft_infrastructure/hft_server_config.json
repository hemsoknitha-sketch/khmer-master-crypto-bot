{
    "cloud_provider": "AWS",
    "region": "ap-northeast-1 (Tokyo)",
    "instance_type": "c6i.metal",
    "os_optimizations": {
        "kernel_bypass": true,
        "dpdk_enabled": true,
        "cpu_pinning": [
            "1-15"
        ],
        "numa_balancing": "strict",
        "tcp_low_latency": true
    },
    "network_interfaces": [
        "Elastic Network Adapter (ENA) - 100 Gbps"
    ]
}